// QUANG SANG (bloom) — TU VIET. Lay 8 diem lan can lam "vung sang" roi CONG
// THEM phan sang vuot nguong. Chi cong theo do sang, khong lech sac.
//!HOOK MAIN
//!BIND HOOKED
//!DESC quang sang vung choi (tu viet)
vec4 hook() {
    vec4 c = HOOKED_tex(HOOKED_pos);
    vec2 p = HOOKED_pt * 3.0;
    vec3 s = vec3(0.0);
    s += HOOKED_tex(HOOKED_pos + vec2( p.x, 0.0)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2(-p.x, 0.0)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2( 0.0, p.y)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2( 0.0,-p.y)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2( p.x, p.y)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2(-p.x, p.y)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2( p.x,-p.y)).rgb;
    s += HOOKED_tex(HOOKED_pos + vec2(-p.x,-p.y)).rgb;
    s /= 8.0;
    float l = dot(s, vec3(0.299, 0.587, 0.114));
    vec3 o = c.rgb + s * smoothstep(0.62, 1.0, l) * 0.38;
    return vec4(clamp(o, 0.0, 1.0), c.a);
}
