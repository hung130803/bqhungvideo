# ============================================================
# BQ Hung Video - Cấu hình (copy file này thành .env rồi điền)
# Để trống = dùng mặc định của app.
# ============================================================

# ---- Chọn LLM provider: groq | ollama | gemini | openai | deepseek ----
# groq  = FREE trên mây, nhanh, khuyên dùng (mặc định) — cần GROQ_API_KEYS bên dưới
# ollama = chạy LOCAL trên máy bạn, FREE, không giới hạn (cần GPU + tải model)
LLM_PROVIDER=groq

# ---- Groq (FREE — lấy key tại https://console.groq.com/keys) ----
# Nhiều key thì mỗi key 1 dòng hoặc cách nhau dấu phẩy (app tự XOAY VÒNG khi hết quota)
GROQ_API_KEYS=
# Model CHÍNH. Groq gỡ model theo tháng — app tự dò /models và có DÂY CHUYỀN
# dự phòng, nên bỏ trống cũng chạy. ĐỪNG điền llama-3.3-70b-versatile: Groq đã
# khai tử nó 17/08/2026 (gọi vào ra 404, KHÔNG phải hết hạn mức key).
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Model dự phòng — PHẢI KHÁC HỌ với model chính, nếu không lưới đổi-model bị
# vô hiệu (đúng lỗi làm app chết 17/08: chính và dự phòng cùng một tên).
GROQ_LLM_FALLBACK=groq/compound
# Dự phòng THÊM, cách nhau dấu phẩy (thử sau 2 model trên).
GROQ_LLM_CHAIN=openai/gpt-oss-20b
# Model nghe-chép lời trên Groq (dùng khi WHISPER_PROVIDER=groq)
GROQ_WHISPER_MODEL=whisper-large-v3
# Model NHÌN ĐƯỢC HÌNH trên Groq (free): AI xem khung hình khắp video khi chọn
# đoạn (cắt thường + reup, cần USE_VISION=1 và LIGHT_MODE=0). Trống = tắt.
# (llama-4-scout ĐÃ BỊ GỠ từ 06/08/2026 — file này còn ghi tên đó tới 17/08.)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ---- API keys provider khác (chỉ cần điền của provider bạn dùng) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# Free tier RẤT giới hạn — xử lý hàng loạt nên dùng key trả phí hoặc Groq.
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- ElevenLabs TTS (giọng lồng tiếng/thuyết minh CAO CẤP — tùy chọn) ----
# Free 10.000 ký tự/tháng. Để TRỐNG = chỉ dùng edge-tts (miễn phí). Có key ->
# mở khóa nhóm giọng 🎧 ElevenLabs (Adam...); hết hạn mức tự lùi về edge-tts.
# Nhiều key: mỗi dòng/dấu phẩy 1 key (tự xoay vòng). Lấy key: elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEYS=
# eleven_multilingual_v2 (mặc định, ổn định) | eleven_v3 (alpha, biểu cảm hơn)
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Vbee AIVoice (giọng Việt HN — MUA CHÍNH HÃNG, tùy chọn) ----
# Để TRỐNG = chỉ dùng edge-tts (miễn phí), app KHÔNG nổ. Có key -> mở khóa
# giọng HN - Ngọc Huyền / HN - Anh Khôi trong hộp chọn giọng.
# Lấy key: đăng nhập vbee.vn -> tạo ứng dụng -> App ID + Access token
# (hướng dẫn: api-docs.vbee.vn/tao-ung-dung-app-id-va-token). CẦN CẢ HAI.
# TIỀN: 1 ký tự = 1 điểm. Gói thường chỉ dùng được MỘT NỬA số điểm qua API,
# phải gói VIP+ mới dùng trọn. Vbee KHÔNG có cửa hỏi số điểm còn lại.
# MỐC CHỮ: Vbee KHÔNG trả mốc từng chữ -> app dựng lại bằng bộ gióng hàng
# (phủ 98,6%, rung 90-119 ms so với 16 ms của edge-tts).
VBEE_APP_ID=
VBEE_TOKEN=

# ---- Ollama (LLM chạy LOCAL — FREE, không giới hạn, không cần mạng) ----
# Cài: https://ollama.com/download  -> PowerShell:  ollama pull qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5vl:7b
# Model NHÌN ĐƯỢC HÌNH (vision) để chấm viral theo khung hình (chỉ dùng khi LIGHT_MODE=0)
OLLAMA_VL_MODEL=qwen2.5vl:7b
USE_VISION=1

# ---- CHẾ ĐỘ MÁY YẾU (mặc định BẬT = 1) ----
# 1 = dồn việc lên mây (Groq chép lời + AI cắt), BỎ dò cảnh / phân tích âm thanh /
#     bám khuôn mặt / chấm điểm bằng hình -> máy yếu vẫn chạy nhanh.
# 0 = bật FULL phân tích cục bộ (cần máy khỏe + cài đủ thư viện requirements.txt:
#     faster-whisper, mediapipe, librosa, PySceneDetect...) -> crop 9:16 bám mặt,
#     chấm điểm audio/cảnh chính xác hơn.
LIGHT_MODE=1

# ---- Sàn chất lượng clip AI cắt (0-100) ----
# Sau khi AI chọn + chấm điểm, clip điểm DƯỚI sàn bị bỏ (chỉ giữ đoạn đáng
# dùng); luôn giữ ít nhất 1 clip điểm cao nhất. 0 = tắt. Mặc định 55.
QUALITY_FLOOR=55

# ---- Nghe-chép lời (whisper): local | groq ----
# local = faster-whisper chạy trên máy (cần cài, chính xác, không cần mạng)
# groq  = gửi audio lên Groq (FREE, nhanh, máy yếu nên dùng)
WHISPER_PROVIDER=local
# Model local: tiny | base | small | medium | large-v3. Trống = tự chọn theo máy.
WHISPER_MODEL=
# Ngôn ngữ chính của video (vi/en/...). Trống = tự nhận diện.
WHISPER_LANGUAGE=
# Thiết bị chạy whisper local: cpu (mặc định, ỔN ĐỊNH) hoặc cuda (GPU, nhanh hơn
# nhưng cần cài cuDNN — thiếu sẽ làm app sập). Cứ để trống nếu không chắc.
WHISPER_DEVICE=

# ---- Diarization (tùy chọn, chỉ khi LIGHT_MODE=0) ----
# Token HuggingFace để tải model pyannote. Bỏ trống = tắt tách người nói.
HUGGINGFACE_TOKEN=

# ---- ffmpeg ----
# Để trống nếu ffmpeg đã có trong PATH (bản .exe đã kèm sẵn). Nếu không, ghi
# đường dẫn tuyệt đối tới ffmpeg.exe / ffprobe.exe.
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Hiệu năng (để trống = app tự đề xuất theo phần cứng) ----
# TIẾT KIỆM MÁY (mặc định 1 = BẬT): app đang xuất/phân tích thì máy vẫn dùng
# bình thường — chỉ 1 job xuất + 1 phân tích cùng lúc, encode ít luồng CPU,
# mọi tiến trình nặng chạy ưu tiên IDLE. Đặt 0 = hiệu năng tối đa.
ECO_MODE=1
# Số luồng PHÂN TÍCH + AI chọn cảnh chạy song song
AI_WORKERS=
# Số luồng CẮT/XUẤT video chạy song song
EXPORT_WORKERS=
# Số worker CPU (giới hạn chung, ít khi cần chỉnh)
MAX_CPU_WORKERS=
# Encoder xuất video: auto | nvenc | libx264
VIDEO_ENCODER=auto
